---
import MonthCalendar from '../components/MonthCalendar.astro';
import Layout from '../layouts/Layout.astro';

const summary = [['sumTutor', 'ผู้สอน'], ['sumMode', 'รูปแบบการเรียน'], ['sumDuration', 'ระยะเวลาต่อครั้ง'], ['sumRate', 'ค่าเรียน']];
---

<Layout title="ยืนยันการจองคลาสเรียน | TutorMatch">
  <main class="mx-auto grid max-w-5xl gap-8 px-6 py-12 lg:grid-cols-[1fr_22rem] lg:items-start">
    <header class="lg:col-span-2">
      <a href="/" class="link text-sm">← กลับไปหน้าค้นหา</a>
      <h1 class="mt-3 text-3xl font-bold">จองคลาสเรียน</h1>
    </header>

    <section class="card lg:order-2">
      <p class="eyebrow">คอร์สที่เลือก</p>
      <h2 id="sumCourse" class="-mt-3 text-xl">…</h2>
      <dl class="flex flex-col gap-2 border-y border-line py-4 text-sm *:flex *:justify-between *:gap-4">
        {summary.map(([id, label]) => <div><dt class="muted">{label}</dt><dd id={id} class="text-right font-medium">…</dd></div>)}
      </dl>
      <div id="syllabus" hidden>
        <h3 class="mb-2 text-sm font-semibold">หัวข้อที่จะได้เรียน</h3>
        <ol class="list-inside list-decimal space-y-1 text-sm text-muted marker:text-accent"></ol>
      </div>
    </section>

    <section class="card lg:order-1">
      <div>
        <h2>1. เลือกวันเรียน</h2>
        <p class="muted mt-1 text-sm">เลือกได้เฉพาะวันที่ติวเตอร์เปิดสอน</p>
      </div>
      <MonthCalendar id="bookingCalendar" />

      <form id="bookingForm" class="flex flex-col gap-5 border-t border-line pt-6">
        <h2>2. เวลาและข้อมูลผู้เรียน</h2>
        <div class="field">
          <label for="startTime">เวลาเริ่มเรียน</label>
          <input type="time" id="startTime" name="startTime" required class="sm:max-w-48" />
          <p id="dayHint" class="text-sm text-accent"></p>
        </div>
        <div class="grid gap-5 sm:grid-cols-2">
          <div class="field"><label for="studentName">ชื่อ-นามสกุล นักเรียน</label><input id="studentName" name="studentName" required /></div>
          <div class="field"><label for="phone">เบอร์โทรศัพท์</label><input id="phone" name="phone" type="tel" required /></div>
        </div>
        <div class="field">
          <label for="notes">ข้อความถึงติวเตอร์ (ไม่บังคับ)</label>
          <textarea id="notes" name="notes" rows="3" placeholder="เช่น อยากเน้นแนวข้อสอบเก่า หรือพื้นฐานที่มีอยู่ตอนนี้"></textarea>
        </div>
        <button type="submit" class="btn-primary self-start px-6">ส่งคำขอจอง</button>
      </form>
    </section>
  </main>
</Layout>

<script src="../scripts/checkout.ts"></script>
