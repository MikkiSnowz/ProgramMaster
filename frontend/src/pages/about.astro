---
import Layout from '../layouts/Layout.astro';

const steps = [
  ['ระบุวิชาและเงื่อนไข', 'เลือกวิชาที่ต้องการเรียน คัดกรองช่วงเวลาที่สะดวก พร้อมเรตราคาและระดับการศึกษาตามงบประมาณที่คุณพอใจ'],
  ['ส่งคำขอจอง', 'ส่งคำร้องนัดหมายผ่านระบบอย่างง่าย ข้อมูลจะไปแจ้งเตือนบนแดชบอร์ดของติวเตอร์ทันทีเพื่อตรวจสอบและยืนยันคลาส'],
  ['เริ่มเรียน', 'ติดตามสถานะการตอบรับผ่านหน้าประวัติการเรียน ตรวจสอบชั่วโมงเรียน และเริ่มเรียนตัวต่อตัวได้อย่างมั่นใจ'],
];
const metrics = [
  ['500+', 'ติวเตอร์ที่ผ่านการตรวจสอบ'],
  ['10,000+', 'ชั่วโมงเรียนที่สอนไปแล้ว'],
  ['4.9 / 5', 'คะแนนรีวิวเฉลี่ยจากผู้เรียน'],
];
---

<Layout title="เกี่ยวกับเรา | TutorMatch">
  <main class="mx-auto flex max-w-6xl flex-col gap-16 px-6 py-16">
    <section class="max-w-3xl">
      <p class="eyebrow mb-4">เกี่ยวกับเรา</p>
      <h1 class="text-4xl leading-tight font-bold md:text-5xl">เชื่อมผู้เรียนกับติวเตอร์ที่ใช่ สำหรับเป้าหมายของแต่ละคน</h1>
      <p class="muted mt-6 text-lg leading-relaxed">ผู้เรียนแต่ละคนมีรูปแบบและเป้าหมายไม่เหมือนกัน เราจึงทำให้การหาติวเตอร์เฉพาะทาง ดูเวลาว่างจริง และนัดเรียน ทำได้ง่ายและโปร่งใสในที่เดียว</p>
    </section>

    <section class="grid gap-px overflow-hidden rounded-xl border border-line bg-line md:grid-cols-3">
      {steps.map(([title, text], i) => (
        <div class="bg-surface p-8">
          <p class="font-display text-3xl font-semibold text-accent">{i + 1}</p>
          <h3 class="mt-4 mb-2 text-xl font-semibold">{title}</h3>
          <p class="muted leading-relaxed">{text}</p>
        </div>
      ))}
    </section>

    <section class="grid gap-8 border-y border-line py-10 text-center md:grid-cols-3">
      {metrics.map(([n, label]) => (
        <div>
          <p class="font-display text-4xl font-bold">{n}</p>
          <p class="muted mt-1">{label}</p>
        </div>
      ))}
    </section>
  </main>
</Layout>
