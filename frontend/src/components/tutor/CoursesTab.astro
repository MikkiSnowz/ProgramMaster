---
import { LEVELS, MODES, SUBJECTS } from '../../lib/model';

const chip = 'cursor-pointer rounded-full border border-line px-3 py-1 text-sm text-muted transition hover:border-ink/30 has-checked:border-accent has-checked:bg-accent-soft has-checked:text-accent';
---
<div class="card">
  <div class="flex flex-wrap items-end justify-between gap-4">
    <div>
      <h2>คอร์สเรียน</h2>
      <p class="muted mt-1 text-sm">รายละเอียด ระดับผู้เรียน รูปแบบการสอน หัวข้อ และการแสดงบนหน้าค้นหา</p>
    </div>
    <button type="button" id="addCourse" class="btn-primary">+ เพิ่มคอร์ส</button>
  </div>
  <div id="courseList" class="flex flex-col gap-3"><p class="muted">กำลังโหลด...</p></div>
</div>

<div class="modal" id="courseModal">
  <div class="max-h-[92vh] max-w-2xl overflow-y-auto">
    <div class="flex items-center justify-between">
      <h3 class="text-xl font-semibold"></h3>
      <button type="button" data-close class="text-2xl leading-none text-muted hover:text-ink" aria-label="ปิด">&times;</button>
    </div>
    <form id="courseForm" class="flex flex-col gap-5">
      <label class="flex cursor-pointer items-center justify-between gap-4 rounded-lg border border-line bg-paper px-4 py-3">
        <span><span class="block font-semibold text-ink">แสดงบนหน้าค้นหา</span><span class="text-xs text-muted">ปิดเพื่อซ่อนคอร์สชั่วคราว นักเรียนจะจองไม่ได้</span></span>
        <input type="checkbox" name="active" class="peer sr-only" />
        <span class="relative h-5 w-9 shrink-0 rounded-full bg-line transition peer-checked:bg-accent after:absolute after:top-0.5 after:left-0.5 after:size-4 after:rounded-full after:bg-white after:shadow after:transition peer-checked:after:translate-x-4"></span>
      </label>

      <div class="field"><label for="cTitle">ชื่อคอร์ส</label><input id="cTitle" name="title" required maxlength="255" placeholder="เช่น Advanced Calculus 3" /></div>
      <div class="grid grid-cols-2 gap-4">
        <div class="field"><label for="cSubject">หมวดวิชา</label><select id="cSubject" name="subject">{SUBJECTS.map((s) => <option>{s}</option>)}</select></div>
        <div class="field"><label for="cMode">รูปแบบการสอน</label><select id="cMode" name="mode">{Object.entries(MODES).map(([v, l]) => <option value={v}>{l}</option>)}</select></div>
        <div class="field"><label for="cRate">ค่าเรียน (บาท/ชม.)</label><input id="cRate" name="rate" type="number" min="0" step="1" required /></div>
        <div class="field"><label for="cHours">ความยาวต่อครั้ง (ชม.)</label><input id="cHours" name="duration_hours" type="number" min="0.5" max="12" step="0.5" required /></div>
      </div>

      <fieldset class="field">
        <legend class="mb-2">ระดับผู้เรียนที่เหมาะสม</legend>
        <div class="flex flex-wrap gap-2">
          {LEVELS.map((l) => <label class={chip}><input type="checkbox" name="level" value={l} class="sr-only" />{l}</label>)}
        </div>
      </fieldset>
      <div class="field"><label for="cTags">แท็กเพิ่มเติม (คั่นด้วยจุลภาค)</label><input id="cTags" name="extraTags" placeholder="เช่น ติวสอบตรง, TGAT" /></div>

      <div class="field"><label for="cDesc">คำอธิบายคอร์ส</label><textarea id="cDesc" name="description" rows="3" required></textarea></div>
      <div class="field">
        <label for="cSyllabus">หัวข้อที่จะได้เรียน (บรรทัดละหัวข้อ)</label>
        <textarea id="cSyllabus" name="syllabus" rows="4" placeholder={'ลิมิตและความต่อเนื่อง\nอนุพันธ์และการประยุกต์'}></textarea>
      </div>

      <div class="flex items-center justify-between gap-3 border-t border-line pt-5">
        <button type="button" id="deleteCourse" class="text-sm font-medium text-danger hover:underline">ลบคอร์สนี้</button>
        <button type="submit" class="btn-primary ml-auto">บันทึกคอร์ส</button>
      </div>
    </form>
  </div>
</div>
