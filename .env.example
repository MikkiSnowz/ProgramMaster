# Copy to .env and change the password. Used by docker-compose.yml.
POSTGRES_USER=tutormatch
POSTGRES_PASSWORD=change-me
POSTGRES_DB=tutormatch

# Host ports
PGPORT=5432
BACKEND_PORT=5000
FRONTEND_PORT=8085

# Backend connection string. Inside Docker the database host is the service name.
# When running the backend outside Docker, use localhost:${PGPORT} instead.
DATABASE_URL=postgres://tutormatch:change-me@postgres-db:5432/tutormatch
